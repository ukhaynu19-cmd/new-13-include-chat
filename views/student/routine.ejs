<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Class Routine</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="app">
  <%- include('../partials/student-sidebar', { page }) %>
  <div class="main">
    <h1 class="page-title">Class Routine</h1>
    <div class="page-sub">Class <%= student.class %><%= student.section ? ' · Group ' + student.section : '' %></div>

    <div class="panel">
      <% if (routine.length === 0) { %>
        <p style="color:var(--muted)">Routine not published yet.</p>
      <% } else { %>
        <input
          type="text"
          id="routine-search"
          placeholder="Search subject or teacher (e.g. Bangla)..."
          style="width:100%;padding:10px;margin-bottom:14px;border-radius:8px;border:1px solid #ccc;font-size:1rem;"
        >
        <table id="routine-table">
          <tr><th>Day</th><th>Period</th><th>Time</th><th>Subject</th><th>Teacher</th></tr>
          <% routine.forEach(r => { %>
          <tr>
            <td><%= r.day %></td>
            <td><%= r.period %></td>
            <td><%= r.time %></td>
            <td><%= r.subject %></td>
            <td><%= r.teacherName %></td>
          </tr>
          <% }) %>
        </table>
        <p id="no-results" style="display:none;color:var(--muted);margin-top:10px;">No matching classes found.</p>
      <% } %>
    </div>
  </div>
</div>
<script>
  const searchInput = document.getElementById('routine-search');
  if (searchInput) {
    const rows = Array.from(document.querySelectorAll('#routine-table tr')).slice(1); // skip header
    const noResults = document.getElementById('no-results');
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;
      rows.forEach(row => {
        const subject = row.children[3].textContent.toLowerCase();
        const teacher = row.children[4].textContent.toLowerCase();
        const match = !q || subject.includes(q) || teacher.includes(q);
        row.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      noResults.style.display = visibleCount === 0 ? '' : 'none';
    });
  }
</script>
</body></html>